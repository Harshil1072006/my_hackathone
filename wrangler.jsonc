{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-hackathone",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "triggers": { "crons": ["23 2 * * *"] }
}
