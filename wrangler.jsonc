{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "swap-hack",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "swap-hack",
    "database_id": "${DB_ID}",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["23 2 * * *"] }
}
